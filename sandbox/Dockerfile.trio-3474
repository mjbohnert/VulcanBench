# Per-task sandbox image for tasks/python-1/oss-trio-memory-channel-max-buffer.
#
# Build:  docker build -t vulcanbench/sandbox:trio-3474 -f sandbox/Dockerfile.trio-3474 .
#
# trio's runtime deps only (attrs, sortedcontainers, outcome, sniffio, idna);
# trio itself is imported from the workspace via PYTHONPATH=src so the workspace
# trio/ is under test.
FROM vulcanbench/sandbox:base

RUN pip install \
    "attrs>=23.2.0" \
    "sortedcontainers" \
    "outcome" \
    "sniffio>=1.3.0" \
    "idna"

RUN python -c "import attr, sortedcontainers, outcome, sniffio, idna" \
    && ! python -c "import trio" 2>/dev/null
